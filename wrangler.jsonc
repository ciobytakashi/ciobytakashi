{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciobytakashi",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ADMIN_EMAIL": "cioby.takashi@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciobytakashi-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "ciobytakashi-images"
    }
  ]
}